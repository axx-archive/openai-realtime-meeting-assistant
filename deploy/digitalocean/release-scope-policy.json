{
  "schema": "bonfire.release-scope-policy.v1",
  "defaultOwnership": "excluded",
  "stagesFiles": false,
  "includeRules": [
    {
      "kind": "rootSuffix",
      "suffix": ".go",
      "excludeSuffix": "_test.go"
    },
    {
      "kind": "prefixSuffix",
      "prefix": "internal/dr/",
      "suffix": ".go",
      "excludeSuffix": "_test.go"
    },
    {
      "kind": "prefix",
      "prefix": "migrations/"
    },
    {
      "kind": "prefix",
      "prefix": "public/"
    },
    {
      "kind": "exact",
      "path": ".dockerignore"
    },
    {
      "kind": "exact",
      "path": "Dockerfile"
    },
    {
      "kind": "exact",
      "path": "Dockerfile.render"
    },
    {
      "kind": "exact",
      "path": "go.mod"
    },
    {
      "kind": "exact",
      "path": "go.sum"
    },
    {
      "kind": "exact",
      "path": "index.html"
    },
    {
      "kind": "exact",
      "path": "packaging_deck_chassis.css"
    },
    {
      "kind": "exact",
      "path": "deploy/digitalocean/docker-compose.yml"
    },
    {
      "kind": "exact",
      "path": "deploy/digitalocean/Caddyfile"
    },
    {
      "kind": "exact",
      "path": "deploy/digitalocean/bonfire-render-runner-v1.apparmor"
    },
    {
      "kind": "exact",
      "path": "deploy/digitalocean/bonfire-render-runner-v1.seccomp.json"
    },
    {
      "kind": "exact",
      "path": "deploy/digitalocean/release-build-inputs.json"
    },
    {
      "kind": "exact",
      "path": "deploy/digitalocean/release-scope-policy.json"
    },
    {
      "kind": "exact",
      "path": "scripts/bonfire-release.mjs"
    }
  ],
  "requiredPaths": [
    ".dockerignore",
    "Dockerfile",
    "Dockerfile.render",
    "go.mod",
    "go.sum",
    "main.go",
    "index.html",
    "packaging_deck_chassis.css",
    "internal/dr/authority.go",
    "deploy/digitalocean/docker-compose.yml",
    "deploy/digitalocean/Caddyfile",
    "deploy/digitalocean/bonfire-render-runner-v1.apparmor",
    "deploy/digitalocean/bonfire-render-runner-v1.seccomp.json",
    "deploy/digitalocean/release-build-inputs.json",
    "deploy/digitalocean/release-scope-policy.json",
    "scripts/bonfire-release.mjs"
  ],
  "releaseConfigPaths": [
    ".dockerignore",
    "Dockerfile",
    "Dockerfile.render",
    "go.mod",
    "go.sum",
    "deploy/digitalocean/docker-compose.yml",
    "deploy/digitalocean/Caddyfile",
    "deploy/digitalocean/bonfire-render-runner-v1.apparmor",
    "deploy/digitalocean/bonfire-render-runner-v1.seccomp.json",
    "deploy/digitalocean/release-build-inputs.json",
    "deploy/digitalocean/release-scope-policy.json",
    "scripts/bonfire-release.mjs"
  ],
  "excludedPrefixes": [
    "stride-site/",
    "data/",
    "docs/evidence/",
    "docs/",
    "artifacts/",
    "apple/",
    "mobile/",
    "brand/",
    "cmd/",
    "deploy/e9/",
    "plans/",
    "testdata/",
    ".superdesign/"
  ]
}
